# Local Docker Compose values only. Replace both placeholders before starting.
DJANGO_SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=0
# HTTP is limited to 127.0.0.1:8001 in the local Compose configuration.
DJANGO_SECURE_COOKIES=0

POSTGRES_DB=asset_management
POSTGRES_USER=asset_app
POSTGRES_PASSWORD=replace-with-a-unique-local-password

# Leave unset unless an approved SCIM sandbox and read-only token are available.
SCIM_BASE_URL=
SCIM_BEARER_TOKEN=
